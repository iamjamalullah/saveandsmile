{
  "cleanUrls": true,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "functions": {
    "api/*.js": {
      "includeFiles": "products.json"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/cart", "dest": "/cart.html" },
    { "src": "/checkout", "dest": "/checkout.html" },
    { "src": "/track-order", "dest": "/track-order.html" },
    { "src": "/track", "dest": "/track-order.html" },
    { "src": "/product-detail", "dest": "/product-detail.html" },
    { "src": "/live-editor", "dest": "/live-editor.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
