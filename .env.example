# ==========================================
# SAVE & SMILE E-COMMERCE ENVIRONMENT CONFIG
# ==========================================

# Application Port & Node Environment
PORT=5000
NODE_ENV=development

# ------------------------------------------
# 1. MICROSOFT SQL SERVER (MSSQL) CONFIG
# ------------------------------------------
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPassword123!
MSSQL_DATABASE=SaveAndSmileDB
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------
# 2. MONGODB CONFIG
# ------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=save_and_smile

# ------------------------------------------
# 3. JWT & AUTHENTICATION
# ------------------------------------------
JWT_SECRET=super_secret_save_and_smile_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------
# 4. NEON POSTGRESQL (OPTIONAL / HYBRID)
# ------------------------------------------
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require
