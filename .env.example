# ==============================================================================
# QADRI GADGETS – PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# Copy to .env in production deployment (Railway, VPS, Render, or Docker)
# NEVER commit the real .env file with secrets into version control!
# ==============================================================================

# Node Environment ('production' enforces strict security, rejects default passwords)
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Cryptographic Token Secret (REQUIRED in production: Generate with: openssl rand -hex 64)
APP_SECRET=replace_with_64_byte_random_cryptographic_hex_secret_key_here

# Token Expiration in Milliseconds (Default: 8 hours = 28800000)
TOKEN_EXPIRY_MS=28800000

# Mandatory Staff Administrator Credentials (REQUIRED: Must NOT be default admin123)
ADMIN_EMAIL=admin@qadrigadgets.pk
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword2026!

# Mandatory Operations Manager Credentials (REQUIRED: Must NOT be default manager123)
MANAGER_EMAIL=manager@qadrigadgets.pk
MANAGER_PASSWORD=ReplaceWithStrongManagerPassword2026!

# Allowed CORS Origins (Comma-separated list of approved frontend domains)
ALLOWED_ORIGINS=https://qadrigadgets.pk,https://www.qadrigadgets.pk,https://admin.qadrigadgets.pk

# Public API URL for Frontend Build
VITE_API_URL=/api
