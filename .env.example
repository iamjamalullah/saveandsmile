# ==============================================================
# SAVE & SMILE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Instructions:
# 1. Copy this file to .env.local for local testing.
# 2. Add these exact environment variables in Vercel Dashboard:
#    Project Settings -> Environment Variables -> Add New
# ==============================================================

# 1. WORDPRESS & WOOCOMMERCE CONNECTION (Private Server-Side Only)
# Your cPanel WordPress site root URL (e.g., https://yourdomain.com or https://admin.saveandsmile.pk)
WORDPRESS_URL=https://your-wordpress-site.com

# WooCommerce REST API Keys (Generated in WordPress: WooCommerce > Settings > Advanced > REST API)
WC_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WC_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here

# 2. WEBHOOK & CACHE REVALIDATION (Real-time syncing from cPanel)
# Secret key used to verify webhook calls from WooCommerce when products are added/edited
WC_WEBHOOK_SECRET=your_custom_webhook_secret_phrase

# Next.js On-Demand ISR Revalidation Secret
REVALIDATE_SECRET=your_nextjs_revalidate_secret_token

# 3. STORE SECURITY & ADMIN AUTHENTICATION
JWT_SECRET=your_secure_random_jwt_secret_token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# 4. ENVIRONMENT RUNTIME
NODE_ENV=production
