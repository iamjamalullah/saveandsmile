{
  "cleanUrls": true,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "functions": {
    "api/*.js": {
      "includeFiles": "products.json"
    }
  },
  "rewrites": [
    { "source": "/admin/live-editor", "destination": "/live-editor.html" },
    { "source": "/live-editor", "destination": "/live-editor.html" },
    { "source": "/track", "destination": "/track-order.html" },
    { "source": "/track-order", "destination": "/track-order.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/product-detail", "destination": "/product-detail.html" }
  ]
}
